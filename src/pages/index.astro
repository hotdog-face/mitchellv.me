---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import SelectedWork from '../components/home/SelectedWork.astro';
import Strengths from '../components/home/Strengths.astro';
import HowIWork from '../components/home/HowIWork.astro';
import About from '../components/home/About.astro';
import Lab from '../components/home/Lab.astro';
import Tiles from '../components/home/Tiles.astro';
import Quote from '../components/home/Quote.astro';
import Contact from '../components/home/Contact.astro';

// Structured data so search engines and link previews know who this site is about.
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Mitchell Vizensky',
  jobTitle: 'Senior UX Designer',
  worksFor: { '@type': 'Organization', name: 'The Pokémon Company International' },
  url: 'https://www.mitchellv.me/',
  email: 'mailto:mail@mitchellv.me',
  address: { '@type': 'PostalAddress', addressLocality: 'Issaquah', addressRegion: 'WA', addressCountry: 'US' },
  knowsAbout: ['UX design', 'Game UX', 'Product design', 'Prototyping', 'User research', 'Live service games', 'Monetization UX'],
  sameAs: ['https://www.linkedin.com/in/mitchellvizensky', 'https://github.com/hotdog-face', 'https://www.behance.net/Mitchellvizensky', 'https://dribbble.com/mvizensk'],
};
---
<Base title="Mitchell Vizensky - Senior Game UX Designer" description="Senior game UX designer who takes features from idea to playable. Collection, progression, live events and stores for Pokémon TCG Live, plus playable prototypes and builds of my own." fonts="family=Heebo:wght@500&family=Quicksand:wght@400">
  <script type="application/ld+json" set:html={JSON.stringify(person)} slot="head" />
  <Hero />
  <SelectedWork />
  <Strengths />
  <HowIWork />
  <About />
  <Lab />
  <Tiles />
  <Quote />
  <Contact />
  <nav class="dot-nav" slot="after" aria-label="Page sections">
    <a href="#top" aria-label="Top of page"></a><a href="#work" aria-label="Selected work"></a><a href="#about" aria-label="About"></a><a href="#builds" aria-label="Builds"></a><a href="#contact" aria-label="Contact"></a>
  </nav>
</Base>

<style>
  .dot-nav { position: fixed; right: 92px; top: 50%; translate: 0 -50%; z-index: 40; display: flex; flex-direction: column; gap: 18px; }
  .dot-nav a { width: 10px; height: 10px; border-radius: 50%; background: #fff; opacity: .55; box-shadow: 0 0 0 1px rgba(0,0,0,.18); }
  .dot-nav a.on, .dot-nav a:hover { opacity: 1; background: var(--pink); }
  @media (max-width: 1299px) { .dot-nav { display: none; } }
</style>
