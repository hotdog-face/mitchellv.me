---
import Base from '../layouts/Base.astro';
import Hero from '../components/home/Hero.astro';
import About from '../components/home/About.astro';
import Featured from '../components/home/Featured.astro';
import Tiles from '../components/home/Tiles.astro';
import Quote from '../components/home/Quote.astro';
import Contact from '../components/home/Contact.astro';
---
<Base title="Mitchell Vizensky - UX/ UI Designer - Seattle, Washington" fonts="family=Heebo:wght@500&family=Quicksand:wght@400">
  <Hero />
  <About />
  <Featured />
  <Tiles />
  <Quote />
  <Contact />
  <nav class="dot-nav" slot="after" aria-label="Page sections">
    <a href="#top" aria-label="Top of page"></a><a href="#about" aria-label="About"></a><a href="#work" aria-label="Work"></a><a href="#contact" aria-label="Contact"></a>
  </nav>
</Base>

<style>
  .dot-nav { position: fixed; right: 92px; top: 50%; translate: 0 -50%; z-index: 40; display: flex; flex-direction: column; gap: 18px; }
  .dot-nav a { width: 10px; height: 10px; border-radius: 50%; background: #fff; opacity: .55; box-shadow: 0 0 0 1px rgba(0,0,0,.08); }
  .dot-nav a.on, .dot-nav a:hover { opacity: 1; }
  @media (max-width: 999px) { .dot-nav { display: none; } }
</style>
