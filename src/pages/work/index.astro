---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getCards } from '../../data/work';
import '../../styles/work.css';

const cards = await getCards();
---
<Base title="MV | Work" description="Game art direction, UX/UI, branding and illustration by Mitchell Vizensky.">
  <div class="work-page work-index">

    <div class="work-intro">
      <a class="work-back" href="/">&larr; Home</a>
      <h1>All Work</h1>
      <p class="work-desc">Product design, UX/UI, game art direction, branding and illustration.</p>
    </div>

    <ProjectGrid cards={cards} eager={6} />

  </div>
</Base>
