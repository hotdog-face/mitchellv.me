---
import Base from '../../layouts/Base.astro';
import ProjectGrid from '../../components/ProjectGrid.astro';
import { getCards, type Card } from '../../data/work';
import { caseStudies, lab } from '../../data/caseStudies';
import '../../styles/work.css';

const all = await getCards();
const byHref = new Map(all.map(c => [c.href, c]));
const cases: Card[] = caseStudies.map(c => ({
  href: c.href, title: c.title, image: c.image,
  line: [c.product, c.year].filter(Boolean).join(' · '),
  note: c.impact[0] ? `${c.impact[0].value} ${c.impact[0].label}` : undefined,
}));
const labCards = lab.map(h => byHref.get(h)!).filter(Boolean);
const taken = new Set([...cases.map(c => c.href), ...lab]);
const archive = all.filter(c => !taken.has(c.href));
---
<Base title="MV | Work" description="Case studies, side projects and earlier work by Mitchell Vizensky, senior UX designer for games.">
  <div class="work-page work-index">

    <div class="work-intro">
      <a class="work-back" href="/">&larr; Home</a>
      <h1>Work</h1>
      <p class="work-desc">Case studies from Pokémon TCG Live, Pokémon TV and Big Fish Games, builds of my own, and earlier art direction and branding.</p>
      <nav class="jump" aria-label="Sections"><a href="#case-studies">Case studies</a><a href="#builds">Builds</a><a href="#archive">Archive</a></nav>
    </div>

    <section id="case-studies" class="group">
      <h2>Case studies</h2>
      <p>The problem, my role, the process and the results.</p>
      <ProjectGrid cards={cases} eager={4} />
    </section>

    <section id="builds" class="group">
      <h2>Builds</h2>
      <p>Software I design and build on my own, from idea to a working build.</p>
      <ProjectGrid cards={labCards} />
    </section>

    <section id="archive" class="group">
      <h2>Archive</h2>
      <p>Earlier UX, game art direction, branding and illustration.</p>
      <ProjectGrid cards={archive} />
    </section>

  </div>
</Base>

<style>
  .jump { display: flex; justify-content: center; gap: 10px; flex-wrap: wrap; margin-top: 8px; }
  .jump a { padding: 6px 14px; border: 1px solid var(--line); border-radius: 999px; font-size: 13px; color: var(--text); text-decoration: none; }
  .jump a:hover { border-color: var(--pink); color: var(--pink); }
  .group { padding: 24px 0 56px; scroll-margin-top: calc(var(--header-h) + 8px); }
  .group > h2, .group > p { width: min(1400px, 100% - 32px); margin-inline: auto; }
  .group > h2 { font-size: clamp(24px, 3vw, 30px); font-weight: 700; color: var(--ink); }
  .group > p { margin-top: 6px; margin-bottom: 24px; color: var(--muted); font-size: 15px; }
</style>
