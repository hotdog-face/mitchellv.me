---
import fs from 'node:fs';
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Glance from '../../components/Glance.astro';
import CardDexDemo from '../../components/case/CardDexDemo.astro';
import NextCase from '../../components/NextCase.astro';
import { getWork, imageSizes, gridSizes, type Project } from '../../data/work';
import { caseStudyFor, nextCaseStudy, vtName } from '../../data/caseStudies';
import '../../styles/work.css';

export async function getStaticPaths() {
  const all = await getWork();
  const n = all.length;
  return all.map((project, i) => ({
    params: { slug: project.slug },
    props: { project, prev: all[(i - 1 + n) % n], next: all[(i + 1) % n] },
  }));
}

interface Props { project: Project; prev: Project; next: Project }
const { project: p, prev, next } = Astro.props;
const dir = `work/${p.slug}`;
const cs = caseStudyFor(`/work/${p.slug}`);
// a project-specific link preview image, if one exists in public/assets/og
const og = fs.existsSync(`public/assets/og/${p.slug}.jpg`) ? `/assets/og/${p.slug}.jpg` : undefined;
const nextCs = nextCaseStudy(`/work/${p.slug}`);
const pub = `/assets/work/${p.slug}`;
const plain = (html: string) => html.replace(/<[^>]+>/g, '').replace(/&nbsp;/g, ' ').replace(/\s+/g, ' ').trim();
const description = p.description ? plain(p.description) : `${p.title} - ${p.meta.fields.join(', ')}. A project by Mitchell Vizensky.`;
---
<Base title={p.pageTitle} description={description} image={og}>
  <div class="work-page">

    <div class="work-intro">
      <a class="work-back" href="/work/">&larr; All work</a>
      <h1 style={`view-transition-name:${vtName(`/work/${p.slug}`)}`}>{p.title}</h1>
      {p.description && <p class="work-desc" set:html={p.description} />}
      <ul class="work-meta">
        {p.meta.date && <li class="work-date">{p.meta.date}</li>}
        {p.meta.fields.map(f => <li>{f}</li>)}
      </ul>
      {p.links && <p class="work-links">{p.links.map((l, i) => <a class:list={['btn', { 'btn--quiet': i > 0 }]} href={l.href} target="_blank" rel="noopener">{l.label}</a>)}</p>}
    </div>

    {cs && <Glance cs={cs} />}
    {cs && <nav class="sect-nav" aria-label="Sections of this case study" data-sect-nav><div class="sect-inner"></div><span class="read-progress" aria-hidden="true"></span></nav>}

    <div class:list={['work-body', { 'is-dark': p.dark }]} style={`--work-bg:${p.background}`}>
      <div class="work-canvas">
        {p.modules.map((m, i) => {
          const loading = i === 0 ? 'eager' : 'lazy';
          switch (m.type) {
            case 'image':
              return (
                <figure class="m m-img" style={m.overlay ? 'position:relative' : m.maxWidth ? `max-width:${m.maxWidth}px;margin-inline:auto` : undefined}>
                  <Img name={`${dir}/${m.name}`} alt={m.alt} sizes={imageSizes(m.maxWidth ?? m.width)} loading={loading} />
                  {m.overlay && (
                    <video src={`${pub}/${m.overlay.name}.mp4`} poster={`${pub}/${m.overlay.name}.webp`} autoplay muted loop playsinline aria-hidden="true"
                      style={`position:absolute;left:${m.overlay.left}%;top:${m.overlay.top}%;width:${m.overlay.width}%;height:auto`}></video>
                  )}
                </figure>
              );
            case 'video':
              return (
                <figure class="m m-img" style={m.maxWidth ? `max-width:${m.maxWidth}px;margin-inline:auto;padding:32px 16px` : undefined}>
                  {i === 0
                    ? <video src={`${pub}/${m.name}.mp4`} poster={`${pub}/${m.name}.webp`} width={m.width} height={m.height}
                        autoplay muted loop playsinline preload="metadata" aria-label={m.label}></video>
                    : <video data-lazy-src={`${pub}/${m.name}.mp4`} poster={`${pub}/${m.name}.webp`} width={m.width} height={m.height}
                        data-autoplay muted loop playsinline preload="none" aria-label={m.label}></video>}
                </figure>
              );
            case 'grid': {
              const sizes = gridSizes(m.items.map(it => it.ratio));
              return (
                <div class="m m-grid" style={m.maxWidth ? `max-width:${m.maxWidth}px;margin-inline:auto` : undefined}>
                  {m.items.map((it, j) => (
                    <div style={`--r:${it.ratio.toFixed(4)}`}>
                      {it.kind === 'image'
                        ? <Img name={`${dir}/${it.name}`} alt={it.alt} sizes={sizes[j]} loading={loading} />
                        : <video data-lazy-src={`${pub}/${it.name}.mp4`} poster={`${pub}/${it.name}.webp`} width={it.width} height={it.height}
                            data-autoplay muted loop playsinline preload="none" aria-label={it.label}></video>}
                    </div>
                  ))}
                </div>
              );
            }
            case 'compare':
              return (
                <figure class="m m-compare" data-compare style={`--pos:50%;max-width:${m.maxWidth ?? 1400}px`}>
                  <div class="cmp-stage" style={`aspect-ratio:${m.after.width}/${m.after.height}`}>
                    <Img name={`${dir}/${m.after.name}`} alt={m.after.alt} sizes={imageSizes(m.maxWidth ?? 1400)} loading={loading} class="cmp-after" />
                    <div class="cmp-before"><Img name={`${dir}/${m.before.name}`} alt={m.before.alt} sizes={imageSizes(m.maxWidth ?? 1400)} loading={loading} /></div>
                    <span class="cmp-label cmp-label-b">{m.beforeLabel}</span>
                    <span class="cmp-label cmp-label-a">{m.afterLabel}</span>
                    <span class="cmp-handle" aria-hidden="true"></span>
                    <input class="cmp-range" type="range" min="0" max="100" value="50" aria-label={`Compare ${m.beforeLabel.toLowerCase()} and ${m.afterLabel.toLowerCase()}`} />
                  </div>
                </figure>
              );
            case 'component':
              return <div class="m m-component">{m.name === 'card-dex-demo' && <CardDexDemo />}</div>;
            case 'text':
              return <div class="m m-text" set:html={m.html.replace(/<(\/?)h3>/g, '<$1h2 class="sh">')} />;
            case 'embed':
              return (
                <div class="m m-embed" style={`max-width:${m.width}px`}>
                  <div style={`aspect-ratio:${m.width}/${m.height}`}>
                    <iframe src={m.src} title={m.title} loading="lazy" allow="fullscreen" allowfullscreen></iframe>
                  </div>
                </div>
              );
          }
        })}
      </div>
    </div>

    {nextCs && <NextCase cs={nextCs} />}
    <nav class="work-pager" aria-label="More projects">
      <a class="prev" href={`/work/${prev.slug}`}><span>&larr; Previous</span><strong>{prev.title}</strong></a>
      <a class="next" href={`/work/${next.slug}`}><span>Next &rarr;</span><strong>{next.title}</strong></a>
      <a class="work-all" href="/work/">All work</a>
    </nav>

  </div>
</Base>
