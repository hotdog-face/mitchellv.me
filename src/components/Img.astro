---
// Responsive image from src/assets. `name` is the file name without extension
// (e.g. "c7fc5658" or "work/bug-brite/01"). Astro generates the smaller sizes.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  name: string;
  alt?: string;
  sizes?: string;
  class?: string;
  style?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  widths?: number[];
}
const { name, alt = '', sizes = '100vw', loading = 'lazy', widths, ...rest } = Astro.props;
const files = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{webp,png,jpg,jpeg,gif}', { eager: true });
const key = Object.keys(files).find(k => k.replace(/^\/src\/assets\/(img\/)?/, '').replace(/\.\w+$/, '') === name);
if (!key) throw new Error(`Img: no asset named "${name}"`);
const src = files[key].default;
const isGif = key.endsWith('.gif');
const w = widths ?? [480, 800, 1200, 1600, 2400].filter(x => x < src.width).concat(src.width);
---
{isGif
  ? <img src={src.src} width={src.width} height={src.height} alt={alt} loading={loading} decoding="async" {...rest} />
  : <Image src={src} widths={w} sizes={sizes} alt={alt} loading={loading} decoding="async" format="webp" quality={82} {...rest} />}
