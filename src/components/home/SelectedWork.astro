---
// Home page: the featured case studies from src/data/caseStudies.ts, each with its results.
import Img from '../Img.astro';
import { caseStudies, vtName } from '../../data/caseStudies';
const featured = caseStudies.filter(c => c.featured);
// "14 → 5": draw the arrow lighter so the two numbers carry the weight
const parts = (v: string) => v.split('→').map(x => x.trim());
---
<section class="selected" id="work">
  <div class="head">
    <h2 class="heading"><b>SELECTED</b> WORK</h2>
    <p class="sub">Shipped features from Pokémon TCG Live, Pokémon TV and Big Fish Casino, with the problem, my role and the results.</p>
  </div>
  <div class="list">
    {featured.map((c, i) => (
      <article class:list={['case', { flip: i % 2 === 1 }]}>
        <a class:list={['media', { alpha: c.homeImageAlpha }]} href={c.href} tabindex="-1" aria-hidden="true" data-anim="float-up" style="--anim-dur:.9s">
          <Img name={c.homeImage ?? c.image} alt="" sizes="(max-width: 860px) calc(100vw - 32px), 560px" loading={i < 2 ? 'eager' : 'lazy'} />
          {c.hoverClip && (
            <video class:list={['hover-clip', { contain: c.hoverClip.fit === 'contain' }]} data-hover-src={`/assets/hover/${c.hoverClip.name}.mp4`} muted loop playsinline preload="none" aria-hidden="true"
              style={c.hoverClip.box ? `left:${c.hoverClip.box[0]}%;top:${c.hoverClip.box[1]}%;width:${c.hoverClip.box[2]}%;height:${c.hoverClip.box[3]}%` : undefined}></video>
          )}
        </a>
        <div class="text" data-anim="float-up" style="--anim-dur:.9s;--anim-delay:.15s">
          <p class="eyebrow">{c.product}{c.year && <> · {c.year}</>}</p>
          <h3 style={`view-transition-name:${vtName(c.href)}`}><a href={c.href}>{c.title}</a></h3>
          <p class="summary">{c.summary}</p>
          {c.impact.length > 0 && (
            <ul class="impact" style={`--n:${Math.min(3, c.impact.length)}`}>
              {c.impact.slice(0, 3).map(s => (
                <li>
                  {s.value.includes('→')
                    ? <strong>{parts(s.value)[0]}<span class="arr" aria-label="to">→</span>{parts(s.value)[1]}</strong>
                    : <strong data-count>{s.value}</strong>}
                  <span class="lbl">{s.label}</span>
                </li>
              ))}
            </ul>
          )}
          <p class="role">{c.role}</p>
          <a class="btn" href={c.href}>Read case study</a>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .selected { background: var(--page-gray); padding: 72px 0 88px; overflow: hidden; }
  .head { width: min(1100px, 100% - 2 * var(--gutter)); margin: 0 auto 56px; text-align: center; }
  .heading { font-size: clamp(28px, 4vw, 37px); color: var(--heading); font-weight: 400; }
  .heading b { color: var(--heading); }
  .sub { margin: 12px auto 0; max-width: 560px; color: var(--text); font-size: 16px; }
  .list { width: min(1100px, 100% - 2 * var(--gutter)); margin-inline: auto; display: grid; gap: 72px; }
  .case { display: grid; grid-template-columns: 1.05fr 1fr; gap: 48px; align-items: center; }
  .case.flip .media { order: 2; }
  .media { position: relative; display: block; border-radius: 14px; overflow: hidden; box-shadow: 0 18px 50px rgba(20, 24, 40, .18); background: var(--card-bg); }
  .media :global(img) { width: 100%; aspect-ratio: 808 / 632; object-fit: cover; transition: transform .5s; }
  .case:hover .media :global(img) { transform: scale(1.025); }
  /* a clip boxed into a device screen can't follow the zoom, so those covers stay still */
  .case:hover .media:has(.hover-clip[style]) :global(img) { transform: none; }
  /* hover clips: fade in over the image while the pointer is on the card */
  .hover-clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .35s; pointer-events: none; border-radius: inherit; }
  .hover-clip.contain { object-fit: contain; background: var(--card-bg); }
  .hover-clip[style] { border-radius: 4px; }
  .hover-clip.playing { opacity: 1; }
  /* cutout images (transparent background) float on the page with no frame */
  .media.alpha { background: none; box-shadow: none; border-radius: 0; overflow: visible; }
  .media.alpha :global(img) { aspect-ratio: auto; object-fit: contain; filter: drop-shadow(0 18px 30px rgba(20, 24, 40, .22)); }
  .eyebrow { margin: 0 0 8px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--pink-ink); font-weight: 700; }
  h3 { font-size: clamp(28px, 3vw, 36px); font-weight: 700; line-height: 1.15; color: var(--ink); }
  h3 a { text-decoration: none; }
  h3 a:hover { color: var(--pink-ink); }
  .summary { margin: 14px 0 0; font-size: 16px; line-height: 1.55; color: var(--text); }
  /* Stats: equal columns, one number size, labels top-aligned under each number */
  .impact { margin: 24px 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr)); max-width: calc(var(--n, 3) * 170px); }
  .impact li { display: flex; flex-direction: column; gap: 6px; padding: 2px 16px; border-left: 1px solid var(--line); }
  .impact li:first-child { padding-left: 0; border-left: 0; }
  .impact strong { display: flex; align-items: center; gap: 6px; font-size: 30px; line-height: 1; font-weight: 700; letter-spacing: -.01em; color: var(--pink-ink); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .impact .arr { font-size: .62em; font-weight: 400; opacity: .55; }
  .impact .lbl { font-size: 13px; line-height: 1.35; color: var(--text); }
  @media (max-width: 400px) { .impact strong { font-size: 25px; } .impact li { padding: 2px 10px; } }
  .role { margin: 20px 0 0; font-size: 13px; color: var(--muted); }
  .text .btn { margin-top: 22px; min-width: 190px; border-radius: 5px; font-size: 18px; }
  @media (max-width: 860px) {
    .selected { padding: 56px 0 64px; }
    .list { gap: 56px; }
    .case { grid-template-columns: 1fr; gap: 22px; }
    .case.flip .media { order: 0; }
  }
</style>
