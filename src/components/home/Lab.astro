---
// Home page "Builds": side projects I design and build myself (src/data/caseStudies.ts → lab).
// The first one gets the big card; the rest sit in a grid under it.
import Img from '../Img.astro';
import { getWork } from '../../data/work';
import { lab } from '../../data/caseStudies';
const all = await getWork();
const items = lab.map(href => all.find(p => `/work/${p.slug}` === href)).filter((p): p is NonNullable<typeof p> => !!p);
const [lead, ...rest] = items;
const github: Record<string, string> = {
  vitaos: 'https://github.com/hotdog-face/VitaOS',
  'gameplay-spotlight': 'https://github.com/hotdog-face/gameplay-spotlight',
  'vita-agent-bridge': 'https://github.com/hotdog-face/vita-agent-bridge',
  'classic-mac': 'https://github.com/hotdog-face/classic-mac',
  'retro-tv': 'https://github.com/hotdog-face/BroadcastBrain',
};
// short loops that play over a build's cover on hover (public/assets/hover/<slug>.mp4)
const hover = new Set(['vitaos', 'hollowtide', 'classic-mac', 'mr2-dash']);
const plain = (html = '') => html.replace(/<[^>]+>/g, '').trim();
---
<section class="lab" id="builds">
  <div class="inner">
    <div class="intro">
      <p class="eyebrow">Builds</p>
      <h2>I design and build my own software, end to end.</h2>
      <p>An MMO revival with its own client and a live server, homebrew for consoles, games for the original black-and-white Macintosh, a dashboard for my car. I take each one from idea to a working build, often with AI coding tools. It keeps my prototyping sharp, and it's how I test ideas for real.</p>
      <p class="gh"><a href="https://github.com/hotdog-face" target="_blank" rel="noopener">Everything is on GitHub →</a></p>
    </div>
    {lead && (
      <article class="lead">
        <a class="media" href={`/work/${lead.slug}`} tabindex="-1" aria-hidden="true"><Img name={`work/${lead.slug}/${lead.card.image}`} alt="" sizes="(max-width: 860px) 100vw, 520px" />{hover.has(lead.slug) && <video class="hover-clip" data-hover-src={`/assets/hover/${lead.slug}.mp4`} muted loop playsinline preload="none" aria-hidden="true"></video>}</a>
        <div class="text">
          <h3><a href={`/work/${lead.slug}`}>{lead.title}</a></h3>
          <p>{plain(lead.description)}</p>
          <div class="links">
            <a class="btn" href={`/work/${lead.slug}`}>See the project</a>
            {github[lead.slug] && <a class="btn btn--ghost" href={github[lead.slug]} target="_blank" rel="noopener">GitHub</a>}
          </div>
        </div>
      </article>
    )}
  </div>
  <div class="grid">
    {rest.map((p, i) => (
      <a class="build" href={`/work/${p.slug}`} data-anim="float-up" style={`--anim-dur:.8s;--anim-delay:${i * 0.1}s`}>
        <span class="cover"><Img name={`work/${p.slug}/${p.card.image}`} alt="" sizes="(max-width: 560px) 100vw, (max-width: 999px) 50vw, 270px" />{hover.has(p.slug) && <video class="hover-clip" data-hover-src={`/assets/hover/${p.slug}.mp4`} muted loop playsinline preload="none" aria-hidden="true"></video>}</span>
        <span class="t">{p.title}</span>
        <span class="d">{plain(p.description)}</span>
      </a>
    ))}
  </div>
</section>

<style>
  .lab { background: #121214; color: #ececef; padding: 80px 0; }
  .inner { width: min(1100px, 100% - 2 * var(--gutter)); margin-inline: auto; display: grid; grid-template-columns: 1fr 1.6fr; gap: 56px; align-items: center; }
  .eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--mint); font-weight: 700; }
  h2 { font-size: clamp(26px, 3vw, 34px); font-weight: 700; color: #fff; line-height: 1.2; }
  .intro p:not(.eyebrow) { margin-top: 14px; color: #b9b9bf; font-size: 16px; line-height: 1.55; }
  .intro .gh a { color: var(--mint); font-weight: 700; text-decoration: none; }
  .lead { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: center; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 18px; }
  .media { position: relative; display: block; border-radius: 10px; overflow: hidden; }
  .cover { position: relative; display: block; border-radius: 10px; overflow: hidden; }
  .hover-clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: #121214; opacity: 0; transition: opacity .35s; pointer-events: none; }
  .hover-clip.playing { opacity: 1; }
  .media :global(img) { width: 100%; aspect-ratio: 960 / 544; object-fit: cover; }
  h3 { font-size: 24px; font-weight: 700; }
  h3 a { color: #fff; text-decoration: none; }
  h3 a:hover { color: var(--mint); }
  .text p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.55; color: #b9b9bf; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .links .btn { min-width: 0; min-height: 44px; padding: 0 18px; border-radius: 5px; font-size: 15px; }
  .links .btn--ghost:hover { color: #121214; }
  .grid { width: min(1100px, 100% - 2 * var(--gutter)); margin: 32px auto 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 20px; }
  .build { display: grid; gap: 8px; align-content: start; text-decoration: none; color: #b9b9bf; }
  .build :global(img) { width: 100%; aspect-ratio: 1150 / 900; object-fit: cover; border-radius: 10px; border: 1px solid rgba(255,255,255,.08); transition: transform .3s; }
  .build:hover :global(img) { transform: translateY(-3px); }
  .t { font-size: 17px; font-weight: 700; color: #fff; }
  .build:hover .t { color: var(--mint); }
  .d { font-size: 13.5px; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  @media (max-width: 999px) { .grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 860px) { .inner, .lead { grid-template-columns: 1fr; gap: 28px; } .lab { padding: 64px 0; } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
