---
// Home page: side projects I design and build myself (src/data/caseStudies.ts → lab).
import Img from '../Img.astro';
import { getWork } from '../../data/work';
import { lab } from '../../data/caseStudies';
const all = await getWork();
const items = lab.map(href => all.find(p => `/work/${p.slug}` === href)!).filter(Boolean);
const github: Record<string, string> = { vitaos: 'https://github.com/hotdog-face/VitaOS' };
const plain = (html = '') => html.replace(/<[^>]+>/g, '').trim();
---
<section class="lab" id="lab">
  <div class="inner">
    <div class="intro">
      <p class="eyebrow">Lab</p>
      <h2>I also design and build my own software.</h2>
      <p>Side projects keep my prototyping sharp. I take them from idea to shipped release on my own: the product thinking, the interface, the motion and the code.</p>
    </div>
    <div class="items">
      {items.map(p => (
        <article class="item">
          <a class="media" href={`/work/${p.slug}`} tabindex="-1" aria-hidden="true"><Img name={`work/${p.slug}/${p.card.image}`} alt="" sizes="(max-width: 860px) 100vw, 520px" /></a>
          <div class="text">
            <h3><a href={`/work/${p.slug}`}>{p.title}</a></h3>
            <p>{plain(p.description)}</p>
            <div class="links">
              <a class="btn" href={`/work/${p.slug}`}>See the project</a>
              {github[p.slug] && <a class="btn btn--ghost" href={github[p.slug]} target="_blank" rel="noopener">GitHub</a>}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .lab { background: #0b0f1a; color: #e8eaf0; padding: 80px 0; }
  .inner { width: min(1100px, 100% - 2 * var(--gutter)); margin-inline: auto; display: grid; grid-template-columns: 1fr 1.6fr; gap: 56px; align-items: center; }
  .eyebrow { margin: 0 0 10px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--mint); font-weight: 700; }
  h2 { font-size: clamp(26px, 3vw, 34px); font-weight: 700; color: #fff; line-height: 1.2; }
  .intro p:last-child { margin-top: 14px; color: #b8bdcb; font-size: 16px; line-height: 1.55; }
  .item { display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: center; background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.08); border-radius: 14px; padding: 18px; }
  .media { display: block; border-radius: 10px; overflow: hidden; }
  .media :global(img) { width: 100%; aspect-ratio: 960 / 544; object-fit: cover; }
  h3 { font-size: 24px; font-weight: 700; }
  h3 a { color: #fff; text-decoration: none; }
  h3 a:hover { color: var(--mint); }
  .text p { margin: 10px 0 0; font-size: 14.5px; line-height: 1.55; color: #b8bdcb; }
  .links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
  .links .btn { min-width: 0; min-height: 44px; padding: 0 18px; border-radius: 5px; font-size: 15px; }
  .links .btn--ghost:hover { color: #0b0f1a; }
  @media (max-width: 860px) { .inner, .item { grid-template-columns: 1fr; gap: 28px; } .lab { padding: 64px 0; } }
</style>
