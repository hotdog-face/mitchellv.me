---
import Img from '../Img.astro';
import Video from '../Video.astro';
import SwitchArt from '../SwitchArt.astro';
import { featured } from '../../data/home';
---
<section class="featured" id="work">
  <h2 class="heading"><b>RECENT</b> PROJECTS</h2>
  {featured.map((p, i) => (
    <article class={`row row-${i + 1}`}>
      <div class="text">
        <h3>{p.title}</h3>
        <p data-anim="fade">{p.text}</p>
        <a class="btn" href={p.href}>See Project</a>
      </div>
      <a class="media" href={p.href} tabindex="-1" aria-hidden="true" data-anim="float" style={`--from:${i === 1 ? '-60px' : '60px'}`}>
        {p.media === 'switch' && (
          <SwitchArt />
        )}
        {p.media === 'phone-video' && <Video name="5b9864ec" class="phone-video" />}
        {p.media === 'phone-image' && <Img name="4cd0f7bd" alt="" class="phone-image" sizes="(max-width: 999px) 80vw, 397px" />}
      </a>
    </article>
  ))}
</section>

<style>
  .featured { background: var(--page-gray); padding: 51px 0 5px; overflow: hidden; }
  .heading { text-align: center; font-size: 37px; color: #222; height: 50px; line-height: 50px; }
  .heading b { color: #000; }
  .row { width: min(var(--content), 100% - 2 * var(--gutter)); margin-inline: auto; display: grid; align-items: start; }
  h3 { font-size: 39px; font-weight: 700; color: var(--text); line-height: 52px; }
  .text p { margin: 12px 0 0; font-size: 16px; line-height: 22.4px; color: #000; }
  .text .btn { margin-top: 80px; width: 201px; border-radius: 5px; font-size: 22px; }
  .media { display: block; }
  .js .media[data-anim]:not(.anim-in) { translate: var(--from) 0; }

  /* Desktop: column widths and offsets match the original layout */
  .row-1 { margin-top: 150px; grid-template-columns: 389px 600px; column-gap: 6px; }
  .row-1 .text { text-align: right; }
  .row-1 .media { margin-top: 52px; }
  .row-2 { margin-top: 85px; grid-template-columns: 419px 506px; column-gap: 32px; padding-left: 22px; }
  .row-2 .media { order: -1; }
  .row-2 .text { margin-top: 130px; }
  .row-3 { margin-top: -36px; grid-template-columns: 438px 397px; column-gap: 48px; padding-left: 42px; }
  .row-3 .text { text-align: right; margin-top: 95px; }
  .row-3 h3 { margin-left: -42px; }

  .media :global(.phone-video) { width: 419px; height: 579px; object-fit: cover; }
  .media :global(.phone-image) { width: 397px; height: 550px; object-fit: cover; }

  @media (max-width: 999px) {
    .featured { padding: 48px 0 56px; }
    .heading { font-size: clamp(28px, 6vw, 37px); }
    .row, .row-1, .row-2, .row-3 { grid-template-columns: 1fr; margin-top: 56px; padding-left: 0; column-gap: 0; }
    .row .text, .row-3 h3 { text-align: center; margin: 0; }
    .row .media { order: 2; margin: 28px auto 0; }
    h3 { font-size: clamp(30px, 7vw, 39px); line-height: 1.2; }
    .text p { font-size: 16px; line-height: 1.55; }
    .text .btn { margin-top: 24px; }
    .media :global(.phone-video), .media :global(.phone-image) { width: min(340px, 80vw); height: auto; margin-inline: auto; }
  }
</style>
