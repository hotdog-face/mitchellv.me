---
import Img from '../Img.astro';
import { hero } from '../../data/home';
---
<section class="hero">
  <Img name={hero.background} alt="" class="bg" sizes="100vw" loading="eager" fetchpriority="high" quality={88} widths={[800, 1200, 1600, 2400, 3200, 4392]} />
  <div class="content">
    <div class="hello-wrap" aria-hidden="true"><svg class="hello" viewBox="0 0 721 221" fill="none" xmlns="http://www.w3.org/2000/svg"> <path d="M178.272 13.824V216H129.024V132.768H52.4165V216H3.16849V13.824H52.4165V93.024H129.024V13.824H178.272Z" stroke="white" stroke-width="5"/> <path d="M365.313 133.056C365.313 137.664 365.025 142.464 364.449 147.456H252.993C253.761 157.44 256.929 165.12 262.497 170.496C268.257 175.68 275.265 178.272 283.521 178.272C295.809 178.272 304.353 173.088 309.153 162.72H361.569C358.881 173.28 353.985 182.784 346.881 191.232C339.969 199.68 331.233 206.304 320.673 211.104C310.113 215.904 298.305 218.304 285.249 218.304C269.505 218.304 255.489 214.944 243.201 208.224C230.913 201.504 221.313 191.904 214.401 179.424C207.489 166.944 204.033 152.352 204.033 135.648C204.033 118.944 207.393 104.352 214.113 91.872C221.025 79.392 230.625 69.792 242.913 63.072C255.201 56.352 269.313 52.992 285.249 52.992C300.801 52.992 314.625 56.256 326.721 62.784C338.817 69.312 348.225 78.624 354.945 90.72C361.857 102.816 365.313 116.928 365.313 133.056ZM314.913 120.096C314.913 111.648 312.033 104.928 306.273 99.936C300.513 94.944 293.313 92.448 284.673 92.448C276.417 92.448 269.409 94.848 263.649 99.648C258.081 104.448 254.625 111.264 253.281 120.096H314.913Z" stroke="white" stroke-width="5"/> <path d="M440.542 2.88V216H391.293V2.88H440.542Z" stroke="white" stroke-width="5"/> <path d="M525.479 2.88V216H476.231V2.88H525.479Z" stroke="white" stroke-width="5"/> <path d="M634.32 218.304C618.576 218.304 604.369 214.944 591.697 208.224C579.217 201.504 569.329 191.904 562.033 179.424C554.929 166.944 551.376 152.352 551.376 135.648C551.376 119.136 555.024 104.64 562.32 92.16C569.616 79.488 579.6 69.792 592.272 63.072C604.944 56.352 619.152 52.992 634.896 52.992C650.64 52.992 664.848 56.352 677.52 63.072C690.192 69.792 700.176 79.488 707.473 92.16C714.769 104.64 718.416 119.136 718.416 135.648C718.416 152.16 714.672 166.752 707.184 179.424C699.888 191.904 689.808 201.504 676.944 208.224C664.272 214.944 650.064 218.304 634.32 218.304ZM634.32 175.68C643.728 175.68 651.696 172.224 658.224 165.312C664.944 158.4 668.304 148.512 668.304 135.648C668.304 122.784 665.04 112.896 658.512 105.984C652.176 99.072 644.304 95.616 634.896 95.616C625.296 95.616 617.328 99.072 610.992 105.984C604.656 112.704 601.488 122.592 601.488 135.648C601.488 148.512 604.56 158.4 610.704 165.312C617.04 172.224 624.912 175.68 634.32 175.68Z" stroke="white" stroke-width="5"/> </svg></div>
    <div class="rule" data-anim="fade"></div>
    <h1 class="name" data-anim="reveal-right" style="--anim-dur:2.05s">{hero.name}</h1>
    <p class="headline" data-anim="fade" style="--anim-delay:.6s">{hero.headline}</p>
    <p class="pitch" data-anim="fade" style="--anim-delay:.9s">{hero.pitch}</p>
    <p class="prev" data-anim="fade" style="--anim-delay:1.1s">{hero.previously}</p>
    <div class="ctas" data-anim="fade" style="--anim-delay:1.3s">
      <a class="btn btn--pink" href="#work">See case studies</a>
      <a class="btn btn--ghost" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
    </div>
  </div>
  <a class="down" href="#work" aria-label="Scroll to case studies"><Img name="8e3a4e80" alt="" /></a>
</section>

<style>
  /* Desktop measurements follow the original: content starts 544px left of center */
  .hero { position: relative; overflow: hidden; min-height: 689px; background: #29050b; color: var(--white); }
  .hero :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  @media (max-width: 999px) { .hero :global(.bg) { top: 0; height: 100%; } }
  .content { position: relative; width: min(1088px, 100% - 2 * var(--gutter)); margin-inline: auto; padding-top: 127px; }
  .hello-wrap { line-height: 0; }
  .hello { width: 216px; height: 66px; overflow: visible; animation: hello-fill .5s ease forwards 3.5s; }
  .hello :global(path) { stroke-dasharray: 1000; stroke-dashoffset: 1000; animation: hello-line 1s ease forwards 1.5s; }
  .hello :global(path:nth-child(1)) { stroke-dasharray: 1200; stroke-dashoffset: 1200; }
  .hello :global(path:nth-child(2)) { animation-duration: 1.5s; }
  .hello :global(path:nth-child(3)) { animation-duration: 2s; }
  .hello :global(path:nth-child(4)) { animation-duration: 3s; }
  .hello :global(path:nth-child(5)) { animation-duration: 3.5s; }
  @keyframes hello-line { to { stroke-dashoffset: 0; } }
  @keyframes hello-fill { from { fill: transparent; } to { fill: #fff; } }
  .rule { width: 170px; margin: 17px 0 0; border-top: 5px dotted rgba(255,255,255,.21); }
  .name { margin: 14px 0 0; font-size: 21px; letter-spacing: .3em; color: var(--pink); font-weight: 400; line-height: 1.3; }
  .headline { margin: 22px 0 0; max-width: 780px; font-size: clamp(30px, 3.8vw, 48px); line-height: 1.08; font-weight: 700; letter-spacing: -.01em; color: var(--white); }
  .pitch { margin: 18px 0 0; max-width: 620px; font-size: clamp(16px, 1.4vw, 19px); line-height: 1.5; color: rgba(255,255,255,.88); }
  .prev { margin: 12px 0 0; font-size: 13px; letter-spacing: .12em; text-transform: uppercase; color: rgba(255,255,255,.6); }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 30px; }
  .ctas .btn { min-width: 190px; border-radius: 5px; font-size: 18px; }
  .ctas .btn--ghost { border-width: 2px; }
  .ctas .btn--ghost:hover { color: #29050b; }
  .down { position: absolute; left: 50%; bottom: 18px; width: 90px; translate: -50% 0; opacity: .8; }
  .content { padding-bottom: 150px; }
  @media (max-width: 999px) {
    .hero { height: auto; min-height: min(640px, 100svh - var(--header-h)); display: flex; flex-direction: column; justify-content: center; }
    .content { padding: 64px 0 120px; }
    .down { width: 72px; }
  }
  @media (prefers-reduced-motion: reduce) { .hello, .hello :global(path) { animation: none; stroke-dashoffset: 0; fill: #fff; } }
</style>
