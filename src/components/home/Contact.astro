---
import { contact } from '../../data/home';
import { email } from '../../data/site';
---
<section class="contact" id="contact">
  <h2>GET IN <span>TOUCH</span></h2>
  <p class="lead">{contact.lead}</p>
  <p class="mail"><a href={`mailto:${email}`}>{email}</a></p>
  <div class="ctas">
    <a class="btn btn--pink" href={`mailto:${email}`}>Email me</a>
    <a class="btn btn--ghost" href="https://www.linkedin.com/in/mitchellvizensky" target="_blank" rel="noopener">LinkedIn</a>
    <a class="btn btn--ghost" href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
  </div>
  <p class="more">Art and illustration on <a href="https://www.behance.net/Mitchellvizensky" target="_blank" rel="noopener">Behance</a> and <a href="https://dribbble.com/mvizensk" target="_blank" rel="noopener">Dribbble</a> · Code on <a href="https://github.com/hotdog-face" target="_blank" rel="noopener">GitHub</a></p>
</section>

<style>
  .contact { background: #000; color: #fffffe; text-align: center; padding: 140px var(--gutter) 150px; }
  h2 { font-size: 45px; line-height: 60px; color: var(--white); }
  h2 span { color: var(--mint); font-weight: 300; }
  .lead { margin: 19px 0 0; font-size: 20px; line-height: 1.6; }
  .mail { margin: 6px 0 0; font-size: 18px; }
  .mail a { color: var(--mint); text-decoration: none; }
  .ctas { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin-top: 32px; }
  .ctas .btn { min-width: 170px; border-radius: 5px; font-size: 18px; }
  .ctas .btn--ghost { border-width: 2px; }
  .ctas .btn--ghost:hover { color: #000; }
  .more { margin: 34px 0 0; font-size: 14px; color: rgba(255,255,255,.6); }
  .more a { color: rgba(255,255,255,.85); }
  @media (max-width: 999px) { .contact { padding: 72px var(--gutter) 88px; } h2 { font-size: clamp(32px, 8vw, 45px); line-height: 1.3; } .lead { font-size: 18px; } }
  @media (max-width: 480px) { .ctas { flex-direction: column; align-items: center; } .ctas .btn { width: min(280px, 100%); } }
</style>
