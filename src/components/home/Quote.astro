---
import Video from '../Video.astro';
import { quote } from '../../data/home';
---
<section class="quote">
  <Video name={quote.video} class="bg" />
  <p data-anim="fade" style="--anim-dur:.6s;--anim-delay:.5s">{quote.text}</p>
</section>

<style>
  .quote { position: relative; overflow: hidden; height: 590px; display: grid; place-items: start center; padding-top: 198px; background: #000; }
  .quote :global(.bg) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .quote::after { content: ""; position: absolute; inset: 0; background: rgba(0,0,0,.59); }
  p { position: relative; z-index: 1; width: min(var(--content), 100% - 2 * var(--gutter)); margin: 0; text-align: center; color: var(--white); font-size: 27px; line-height: 40.5px; letter-spacing: .05em; }
  @media (max-width: 999px) { .quote { height: auto; min-height: 420px; place-items: center; padding: 72px 0; } p { font-size: clamp(19px, 4.4vw, 27px); line-height: 1.5; } }
</style>
