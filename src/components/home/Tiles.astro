---
// Home page archive: earlier work not already shown in Selected work or Builds, as one consistent
// tile style (cover, title and year over a soft gradient). Capped at three rows; /work has everything.
import Img from '../Img.astro';
import { getCards } from '../../data/work';
import { caseStudies, lab } from '../../data/caseStudies';

const above = new Set<string>([...caseStudies.filter(c => c.featured).map(c => c.href), ...lab]);
const ARCHIVE_MAX = 9;
const items = (await getCards()).filter(c => !above.has(c.href)).slice(0, ARCHIVE_MAX)
  .map(c => ({ ...c, short: c.title.split(/ [-—–] /)[0] }));
const sizes = '(max-width: 820px) 46vw, 330px';
---
<section class="tiles-band" id="archive">
  <div class="head">
    <h2 class="heading"><b>ARCHIVE</b></h2>
    <p class="sub">Earlier UX, game art direction, branding and illustration from Big Fish Games, PLAYSTUDIOS and Amazon.</p>
  </div>
  <div class="tiles">
    {items.map((c, i) => (
      <a class="tile" href={c.href} data-anim="float-up" style={`--anim-dur:.8s;--anim-delay:${(i % 3) * 0.1}s`}>
        <Img name={c.image} alt="" sizes={sizes} />
        <span class="cap"><span class="t">{c.short}</span><span class="l">{c.line}</span></span>
      </a>
    ))}
  </div>
  <p class="more"><a class="btn" href="/work/#archive">See the full archive</a></p>
</section>

<style>
  .tiles-band { background: var(--band); padding: 72px 0; overflow: hidden; }
  .head { width: min(1100px, 100% - 2 * var(--gutter)); margin: 0 auto 36px; text-align: center; }
  .heading { font-size: clamp(28px, 4vw, 37px); color: var(--heading); }
  .sub { margin: 10px auto 0; max-width: 560px; font-size: 16px; color: var(--text); }
  .tiles { width: min(1100px, 100% - 2 * var(--gutter)); margin-inline: auto; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .tile { position: relative; display: block; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; background: #cfd2da; isolation: isolate; box-shadow: 0 8px 24px rgba(20, 24, 40, .12); }
  .tile :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: transform .5s cubic-bezier(.22,.8,.3,1); }
  .tile::after { content: ""; position: absolute; inset: 0; background: linear-gradient(to top, rgba(10, 12, 20, .82) 0%, rgba(10, 12, 20, .35) 32%, rgba(10, 12, 20, 0) 55%); transition: opacity .3s; }
  .cap { position: absolute; left: 16px; right: 16px; bottom: 14px; z-index: 1; display: grid; gap: 2px; color: #fff; }
  .t { font-size: 18px; font-weight: 700; line-height: 1.2; }
  .l { font-size: 12.5px; color: rgba(255, 255, 255, .78); }
  .tile:hover :global(img), .tile:focus-visible :global(img) { transform: scale(1.05); }
  .tile:focus-visible { outline: 3px solid var(--pink); outline-offset: 3px; }
  .more { margin: 36px 0 0; text-align: center; }
  .more .btn { border-radius: 5px; font-size: 18px; }
  @media (max-width: 820px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; } }
  /* phones: two small columns, three rows; /work has the rest */
  @media (max-width: 520px) {
    .tiles-band { padding: 56px 0; }
    .tiles { gap: 12px; }
    .tile { border-radius: 10px; }
    .tile:nth-child(n+7) { display: none; }
    .cap { left: 10px; right: 10px; bottom: 9px; }
    .t { font-size: 14px; }
    .l { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .tile :global(img) { transition: none; } }
</style>
