---
import Img from '../Img.astro';
import Video from '../Video.astro';
import { tiles, clients } from '../../data/home';
---
<section class="tiles-band">
  <div class="tiles">
    {tiles.map(t => (
      <a class="tile" href={t.href} aria-label={t.label}>
        {t.video ? <Video name={t.video} class="base" /> : <Img name={t.image!} alt="" class="base" sizes="(max-width: 640px) 92vw, 310px" />}
        <Img name={t.hover} alt="" class="hover" sizes="(max-width: 640px) 92vw, 310px" />
        {t.pressed && <Img name={t.pressed} alt="" class="pressed" sizes="(max-width: 640px) 92vw, 310px" />}
      </a>
    ))}
  </div>
  <p class="more"><a class="btn" href="/work/">More Projects</a></p>
  <Img name={clients.image} alt={clients.alt} class="clients" sizes="100vw" data-anim="fly" />
</section>

<style>
  .tiles-band { background: #e8e8e8; padding: 78px 0 11px; overflow: hidden; }
  .tiles { width: min(var(--content), 100% - 2 * var(--gutter)); margin-inline: auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 21px 25px; }
  .tile { position: relative; display: block; aspect-ratio: 310 / 220; }
  .tile > :global(*) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .1s; }
  .tile :global(.hover), .tile :global(.pressed) { opacity: 0; transition: opacity .5s; }
  .tile:hover :global(.hover), .tile:focus-visible :global(.hover) { opacity: 1; }
  .tile:active :global(.pressed) { opacity: 1; transition-duration: .1s; }
  .tile:active :global(.hover) { opacity: 0; }
  .more { margin: 37px 0 0; text-align: center; }
  .more .btn { width: 201px; border-radius: 5px; font-size: 22px; }
  .tiles-band :global(.clients) { width: min(1430px, 100%); margin: 50px auto 0; height: auto; }
  .more { line-height: 0; }
  @media (max-width: 820px) { .tiles { grid-template-columns: repeat(2, 1fr); gap: 16px; } }
  @media (max-width: 520px) { .tiles { grid-template-columns: 1fr; } .tiles-band { padding-top: 48px; } }
</style>
