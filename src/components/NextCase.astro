---
// "Next case study" link at the end of a case study, following the order in src/data/caseStudies.ts.
import Img from './Img.astro';
import type { CaseStudy } from '../data/caseStudies';
interface Props { cs: CaseStudy }
const { cs } = Astro.props;
---
<nav class="next-case" aria-label="Next case study">
  <a href={cs.href}>
    <span class="label">Next case study</span>
    <span class="row">
      <span class="text"><strong>{cs.title}</strong><span>{cs.product}{cs.year && <> · {cs.year}</>}</span></span>
      <Img name={cs.image} alt="" sizes="240px" class="thumb" />
    </span>
  </a>
</nav>

<style>
  .next-case { background: #18181b; font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  a { display: block; width: min(1100px, 100% - 32px); margin-inline: auto; padding: 40px 0; color: #fff; text-decoration: none; }
  .label { display: block; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: #9a9aa2; margin-bottom: 14px; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 24px; }
  .text { display: grid; gap: 6px; }
  strong { font-size: clamp(24px, 3vw, 34px); transition: color .2s; }
  .text > span { color: #9a9aa2; font-size: 14px; }
  a:hover strong { color: #ff6fae; }
  a :global(.thumb) { width: 200px; aspect-ratio: 808 / 632; object-fit: cover; border-radius: 10px; flex: none; }
  @media (max-width: 560px) { a :global(.thumb) { width: 110px; } }
</style>
