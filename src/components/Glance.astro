---
// "At a glance" summary at the top of a case study: company, role, team, platforms and results.
// Facts come from src/data/caseStudies.ts.
import { vtName, type CaseStudy } from '../data/caseStudies';
// `intro` adds a back link, title and summary (for the case studies whose page has no intro of its own).
interface Props { cs: CaseStudy; dark?: boolean; intro?: boolean }
const { cs, dark = false, intro = false } = Astro.props;
---
<section class:list={['glance', { dark }]} aria-label="At a glance">
  <div class="inner">
    {intro && (
      <div class="intro">
        <a class="back" href="/work/">&larr; All work</a>
        <p class="eyebrow">{cs.product}{cs.year && <> · {cs.year}</>}</p>
        <p class="title" style={`view-transition-name:${vtName(cs.href)}`}>{cs.title}</p>
        <p class="summary">{cs.summary}</p>
      </div>
    )}
    <dl class="facts">
      <div><dt>Company</dt><dd>{cs.company}</dd></div>
      <div><dt>Role</dt><dd>{cs.role}</dd></div>
      <div><dt>Team</dt><dd>{cs.team}</dd></div>
      <div><dt>Platforms</dt><dd>{cs.platforms}{cs.year && <> · {cs.year}</>}</dd></div>
    </dl>
    {cs.impact.length > 0 && (
      <ul class="impact" style={`--n:${cs.impact.length}`}>
        {cs.impact.map(s => <li>{s.value.includes('→')
          ? <strong>{s.value.split('→')[0].trim()}<span class="arr" aria-label="to">→</span>{s.value.split('→')[1].trim()}</strong>
          : <strong data-count>{s.value}</strong>}<span class="lbl">{s.label}</span></li>)}
      </ul>
    )}
  </div>
</section>

<style>
  .glance { position: relative; z-index: 1; --g-text: var(--text); --g-muted: #5f6470; --g-line: #e2e4ea; --g-bg: #f7f8fb; background: var(--g-bg); border-block: 1px solid var(--g-line); font-family: "Helvetica Neue", Helvetica, Arial, sans-serif; }
  .glance.dark { --g-text: #ececef; --g-muted: #9a9aa2; --g-line: rgba(255,255,255,.1); --g-bg: rgba(255,255,255,.04); }
  .inner { width: min(1100px, 100% - 32px); margin-inline: auto; padding: 28px 0; display: grid; gap: 24px; }
  .intro { padding: 24px 0 8px; }
  .back { display: inline-block; margin-bottom: 18px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--g-muted); text-decoration: none; }
  .back:hover { color: var(--pink); }
  .eyebrow { margin: 0 0 6px; font-size: 12px; letter-spacing: .2em; text-transform: uppercase; color: var(--pink); font-weight: 700; }
  .title { margin: 0; font-size: clamp(30px, 4vw, 42px); font-weight: 700; line-height: 1.12; color: var(--ink); }
  .summary { margin: 12px 0 0; max-width: 720px; font-size: 17px; line-height: 1.55; color: var(--g-text); }
  .facts { margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px 32px; }
  dt { font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--g-muted); margin-bottom: 4px; }
  dd { margin: 0; font-size: 14px; line-height: 1.45; color: var(--g-text); }
  .impact { margin: 0; padding: 22px 0 0; list-style: none; display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 240px)); border-top: 1px solid var(--g-line); }
  .impact li { display: flex; flex-direction: column; gap: 6px; padding: 2px 20px; border-left: 1px solid var(--g-line); }
  .impact li:first-child { padding-left: 0; border-left: 0; }
  .impact strong { display: flex; align-items: center; font-size: clamp(26px, 2.6vw, 32px); line-height: 1; font-weight: 700; letter-spacing: -.01em; color: var(--pink); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .glance.dark .impact strong { color: #ff6fae; }
  @media (prefers-color-scheme: dark) { :global(:root:not([data-theme="light"])) .glance { --g-text: #ececef; --g-muted: #9a9aa2; --g-line: rgba(255,255,255,.1); --g-bg: rgba(255,255,255,.04); } :global(:root:not([data-theme="light"])) .impact strong { color: #ff6fae; } }
  .impact .lbl { font-size: 13.5px; line-height: 1.4; color: var(--g-text); }
  .impact strong .arr { margin: 0 6px; font-size: .62em; font-weight: 400; opacity: .55; color: inherit; }
  @media (max-width: 820px) { .facts { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 480px) { .facts { grid-template-columns: 1fr; } .impact strong { font-size: 24px; } .impact li { padding: 2px 10px; } }
</style>
