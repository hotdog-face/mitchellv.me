---
import Img from './Img.astro';
import { social } from '../data/site';
---
<header class="site-header">
  <nav class="site-nav" aria-label="Sections">
    <a href="/#work">WORK</a>
    <a href="/#about">ABOUT</a>
    <a href="/#contact">CONTACT</a>
  </nav>
  <a class="logo" href="/" aria-label="Mitchell Vizensky, home">MV</a>
  <div class="social">
    {social.map(s => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Img name={s.icon} sizes="26px" loading="eager" /></a>)}
  </div>
</header>

<style>
  .site-header {
    position: sticky; top: 0; z-index: 50; height: var(--header-h);
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center;
    padding: 0 clamp(16px, 8vw, 113px); background: var(--white); box-shadow: 0 1px 0 rgba(0,0,0,.06);
  }
  .site-nav { display: flex; gap: clamp(16px, 2.5vw, 32px); }
  .site-nav a { font-size: 12px; letter-spacing: .2em; text-decoration: none; color: var(--ink); }
  .site-nav a:hover { color: var(--pink); }
  .logo { font-family: var(--logo); font-size: 32px; line-height: 1; color: var(--ink); text-decoration: none; }
  .social { display: flex; gap: 18px; justify-content: flex-end; align-items: center; }
  .social a { opacity: .85; transition: opacity .2s; }
  .social a:hover { opacity: 1; }
  .social :global(img) { height: 20px; width: auto; }
  @media (max-width: 820px) {
    .site-header { grid-template-columns: auto 1fr; gap: 12px; }
    .logo { order: -1; }
    .site-nav { justify-content: flex-end; }
    .social { display: none; }
  }
  @media (max-width: 380px) { .site-nav a { letter-spacing: .1em; } }
</style>
