---
// Fixed bottom bar of quick links on phones, as on the original mobile site.
import { email } from '../data/site';
const links = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/mitchellvizensky', d: 'M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9.5h4V21H3zM9.5 9.5h3.8v1.6h.06c.53-1 1.83-2.06 3.77-2.06 4.03 0 4.77 2.65 4.77 6.1V21h-4v-5.1c0-1.22-.02-2.78-1.7-2.78-1.7 0-1.96 1.33-1.96 2.7V21h-4z' },
  { label: 'Work', href: '/#work', d: 'M9 3h6a2 2 0 0 1 2 2v2h3a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h3V5a2 2 0 0 1 2-2zm0 4h6V5H9zM4 9v4h16V9zm0 6v4h16v-4h-6v1h-4v-1z' },
  { label: 'Resume', href: '/resume.pdf', d: 'M6 2h9l5 5v15H6zm8 1.5V8h4.5zM8 11v1.6h10V11zm0 3.4V16h10v-1.6zm0 3.4v1.6h7v-1.6z' },
  { label: 'Email', href: `mailto:${email}`, d: 'M2 5h20v14H2zm2 2v.6l8 5.1 8-5.1V7zm16 2.9-8 5.1-8-5.1V17h16z' },
];
---
<nav class="phone-bar" aria-label="Quick links">
  {links.map(l => <a href={l.href} target={l.href.startsWith('http') || l.href.endsWith('.pdf') ? '_blank' : undefined} rel="noopener" aria-label={l.label}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.d} /></svg></a>)}
</nav>
<a class="to-top" href="#top" aria-label="Back to top"></a>

<style>
  .phone-bar { display: none; }
  @media (max-width: 999px) {
    .phone-bar { position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--white); border-top: 1px solid #e5e5e5; padding-bottom: env(safe-area-inset-bottom); }
    .phone-bar a { display: grid; place-items: center; height: 50px; color: #000; border-left: 1px solid #eee; }
    .phone-bar a:first-child { border-left: 0; }
    .phone-bar svg { width: 24px; height: 24px; fill: currentColor; }
  }
  .to-top { position: fixed; right: 22px; bottom: 22px; z-index: 40; width: 36px; height: 36px; border: 1px solid #fff; background: rgba(0,0,0,.25); }
  .to-top::before { content: ""; position: absolute; left: 50%; top: 55%; width: 10px; height: 10px; border: solid #fff; border-width: 1px 0 0 1px; transform: translate(-50%, -50%) rotate(45deg); }
  @media (max-width: 999px) { .to-top { display: none; } }
</style>
