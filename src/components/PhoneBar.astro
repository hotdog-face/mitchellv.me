---
<nav class="phone-bar" aria-label="Quick links">
  {links.map(l => <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={l.label}><svg viewBox="0 0 24 24" aria-hidden="true"><path d={l.d} /></svg></a>)}
</nav>
<a class="to-top" href="#top" aria-label="Back to top"></a>

<style>
  .phone-bar { display: none; }
  @media (max-width: 999px) {
    .phone-bar { position: fixed; inset: auto 0 0 0; z-index: 40; display: grid; grid-template-columns: repeat(4, 1fr); background: var(--white); border-top: 1px solid #e5e5e5; padding-bottom: env(safe-area-inset-bottom); }
    .phone-bar a { display: grid; place-items: center; height: 50px; color: #000; border-left: 1px solid #eee; }
    .phone-bar a:first-child { border-left: 0; }
    .phone-bar svg { width: 24px; height: 24px; fill: currentColor; }
  }
  .to-top { position: fixed; right: 22px; bottom: 22px; z-index: 40; width: 36px; height: 36px; border: 1px solid #fff; background: rgba(0,0,0,.25); }
  .to-top::before { content: ""; position: absolute; left: 50%; top: 55%; width: 10px; height: 10px; border: solid #fff; border-width: 1px 0 0 1px; transform: translate(-50%, -50%) rotate(45deg); }
  @media (max-width: 999px) { .to-top { display: none; } }
</style>
