---
// Two-by-two grid of icons with a heading, green rule and text (BFC "Engineering Costing" etc.).
import Img from '../Img.astro';
interface Props { items: { icon: string; iconWidth: number; iconHeight: number; title: string; text: string; size?: number }[] }
const { items } = Astro.props;
---
<div class="phases">
  {items.map(p => (
    <div class="phase" data-anim="float-up">
      <div class="icon"><Img name={p.icon} alt="" sizes={`${p.iconWidth}px`} style={`width:${p.iconWidth}px;height:${p.iconHeight}px`} /></div>
      <h3 style={p.size ? `font-size:${p.size}px` : undefined}>{p.title}</h3>
      <span class="rule" aria-hidden="true"></span>
      <p>{p.text}</p>
    </div>
  ))}
</div>

<style>
  .phases { display: grid; grid-template-columns: 427px 449px; justify-content: center; column-gap: 40px; row-gap: 26px; }
  .phase { text-align: center; }
  .icon { height: 172px; display: flex; align-items: flex-end; justify-content: center; }
  .icon :global(img) { object-fit: contain; }
  h3 { margin-top: 8px; font-size: 22px; font-weight: 700; color: var(--text); }
  .rule { display: block; width: 76px; margin: 10px auto 0; border-top: 2px solid #43c296; }
  p { margin: 14px 0 0; font-size: 13px; line-height: 1.3; }
  @media (max-width: 999px) { .phases { grid-template-columns: 1fr; row-gap: 48px; } .icon { height: auto; } p { font-size: 15px; line-height: 1.5; } }
</style>
