---
// Page wrapper for case-study MDX files.
import Base from '../../layouts/Base.astro';
import Glance from '../Glance.astro';
import NextCase from '../NextCase.astro';
import { caseStudyFor, nextCaseStudy } from '../../data/caseStudies';
const { frontmatter } = Astro.props;
const cs = caseStudyFor(Astro.url.pathname);
const nextCs = nextCaseStudy(Astro.url.pathname);
---
<Base title={frontmatter.title} description={frontmatter.description} image={frontmatter.ogImage} fonts="family=Jost:wght@400" theme="light">
  {cs && <Glance cs={cs} intro />}
  <div class="case" style={`background:${frontmatter.pageColor ?? '#fff'}`}><slot /></div>
  {nextCs && <NextCase cs={nextCs} />}
</Base>
<style>
  .case { overflow-x: clip; }
  .case :global(.caption) { font-size: 12px; color: var(--muted); text-align: center; }
  .case :global(.lede) { text-align: center; }
</style>
