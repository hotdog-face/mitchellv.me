---
import Img from './Img.astro';
import { footerSocial, lastUpdated } from '../data/site';
---
<footer class="site-footer">
  <div class="inner">
    <p>Last updated {lastUpdated} <span class="muted">| Copyright © {lastUpdated} | All Rights Reserved by</span> <a href="/">Mitchell Vizensky</a>.</p>
    <div class="icons">
      {footerSocial.map(s => <a href={s.href} target="_blank" rel="noopener" aria-label={s.label}><Img name={s.icon} sizes="20px" /></a>)}
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--teal-dark); color: var(--white); font-size: 15px; padding: 14px var(--gutter); }
  .inner { width: min(var(--content), 100%); margin-inline: auto; display: flex; justify-content: space-between; align-items: center; gap: 12px 24px; flex-wrap: wrap; }
  p { margin: 0; }
  .muted { color: #3fa587; }
  a { color: var(--mint); text-decoration: none; }
  .icons { display: flex; gap: 10px; }
  .icons :global(img) { width: 20px; height: 20px; }
  @media (max-width: 999px) { .site-footer { padding-bottom: 64px; } .inner { justify-content: center; text-align: center; } }
</style>
