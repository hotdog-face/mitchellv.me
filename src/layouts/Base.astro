---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneBar from '../components/PhoneBar.astro';

interface Props { title: string; description?: string; fonts?: string }
const { title, description = 'Mitchell Vizensky — Senior UX/UI Designer at The Pokémon Company International. Portfolio of game and product design work.', fonts } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonical}>
  <link rel="icon" href="/assets/favicon.png">
  {fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
  {fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
  {fonts && <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />}
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body id="top">
  <Header />
  <main><slot /></main>
  <Footer />
  <PhoneBar />
  <slot name="after" />
  <script src="../scripts/site.ts"></script>
</body>
</html>
